# Copy to .env.local and fill in. Everything except NEXT_PUBLIC_* stays on the server.

# App
APP_URL=http://localhost:3000
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Meta Instagram API (Instagram Login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must match the redirect URI registered in the Meta app, served through the ngrok static domain
INSTAGRAM_REDIRECT_URI=https://<your-domain>.ngrok-free.app/api/auth/instagram/callback
# Any random string; paste the same value as the Verify Token of the webhook (https://<your-domain>/api/webhooks/instagram)
# in the Meta app. Webhook payloads are signed with INSTAGRAM_APP_SECRET.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Supabase (self-hosted). The worker needs the URL, the service-role key and TOKEN_ENCRYPTION_KEY.
# Use the public HTTPS URL: Meta downloads post photos from signed URLs built on it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 9Router (AI in Buat). Any chat model id from GET /v1/models works. On 2026-10-16 the Hermes-daily
# combo answered every request with a provider notice, so the app uses Claude Haiku 4.5 directly.
ROUTER_API_BASE_URL=
ROUTER_API_KEY=
ROUTER_MODEL=cc/claude-haiku-4-5-20251001
