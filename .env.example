# Copy to .env.local and fill in. Everything except NEXT_PUBLIC_* stays on the server.

# App. APP_URL is the public domain users sign in on (ngrok in dev): session cookies belong to it, and the OAuth
# callbacks read the session, so it must be the same host as the redirect URIs below.
APP_URL=https://<your-domain>
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Meta Instagram API (Instagram Login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must match the redirect URI registered in the Meta app, served through the ngrok static domain
INSTAGRAM_REDIRECT_URI=https://<your-domain>.ngrok-free.app/api/auth/instagram/callback
# Any random string; paste the same value as the Verify Token of the webhook (https://<your-domain>/api/webhooks/instagram)
# in the Meta app. Webhook payloads are signed with INSTAGRAM_APP_SECRET.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Meta Facebook Login, only for Business Discovery (other accounts' posts as design references on /brand).
# App ID and secret come from App settings → Basic: they differ from the Instagram app ID and secret above.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Register the same URL under Facebook Login → Valid OAuth Redirect URIs
FACEBOOK_REDIRECT_URI=https://<your-domain>.ngrok-free.app/api/auth/facebook/callback
# Facebook Login for Business configuration (User access token, with the permissions in src/lib/facebook.ts).
# Leave empty for classic Facebook Login, which takes the permissions as `scope` instead.
FACEBOOK_LOGIN_CONFIG_ID=

# Supabase (self-hosted). The worker needs the URL, the service-role key and TOKEN_ENCRYPTION_KEY.
# Use the public HTTPS URL: Meta downloads post photos from signed URLs built on it.
# The publishable key is for Supabase Auth (sign in and out); data still goes through the service-role key.
# Supabase's own .env needs ENABLE_EMAIL_SIGNUP=true and ENABLE_EMAIL_AUTOCONFIRM=true (there is no SMTP).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 9Router (AI in Buat). Any chat model id from GET /v1/models works. On 2026-10-16 the Hermes-daily
# combo answered every request with a provider notice, so the app uses Claude Haiku 4.5 directly.
ROUTER_API_BASE_URL=
ROUTER_API_KEY=
ROUTER_MODEL=cc/claude-haiku-4-5-20251001
# Mayar (langganan). API key from the Mayar dashboard (Integrasi → API Key); register the webhook
# https://<your-domain>/api/webhooks/mayar there too. Sandbox: MAYAR_API_BASE_URL=https://api.mayar.io/hl/v2
MAYAR_API_KEY=
MAYAR_API_BASE_URL=https://api.mayar.id/hl/v2

# Optional: image model for Gambar AI (/studio and the post editor). Image models are listed in the 9Router dashboard,
# not in /v1/models. Defaults to cx/gpt-image-2.5.
ROUTER_IMAGE_MODEL=
