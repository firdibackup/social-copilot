# Copy to .env.local and fill in. Everything except NEXT_PUBLIC_* stays on the server.

# App
APP_URL=http://localhost:3000
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Meta Instagram API (Instagram Login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must match the redirect URI registered in the Meta app, served through the ngrok static domain
INSTAGRAM_REDIRECT_URI=https://<your-domain>.ngrok-free.app/api/auth/instagram/callback

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 9Router (used from the "Buat" phase onward)
ROUTER_API_BASE_URL=
ROUTER_API_KEY=
ROUTER_MODEL=Hermes-daily
